{
  "name": "brainseg-web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.22.3 <23", "npm": ">=10 <12" },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "lint": "eslint src",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "format": "prettier --write src angular.json tsconfig*.json eslint.config.mjs proxy.conf.cjs playwright.config.ts",
    "format:check": "prettier --check src angular.json tsconfig*.json eslint.config.mjs proxy.conf.cjs playwright.config.ts",
    "generate-proxy": "node tools/generate-proxy.mjs"
  },
  "dependencies": {
    "@abp/ng.core": "10.7.1",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@ngx-validate/core": "0.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@abp/ng.schematics": "10.7.1",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@angular-devkit/schematics": "22.2.6",
    "@schematics/angular": "22.2.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@abp/ng.schematics": {
      "@angular/cli": "$@angular/cli",
      "@angular-devkit/core": "22.2.6",
      "@angular-devkit/schematics": "$@angular-devkit/schematics"
    },
    "@modelcontextprotocol/sdk": "1.32.2",
    "@hono/node-server": "2.1.3",
    "glob@>=9": "14.0.3",
    "minimatch@>=7": "11.0.5",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true
  }
}