COMPOSE_PROJECT_NAME=brainseg
POSTGRES_IMAGE=postgres:17-alpine
MINIO_IMAGE=brainseg-minio:local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brainseg
POSTGRES_USER=brainseg
POSTGRES_PASSWORD=replace-with-random-postgres-password
MINIO_ROOT_USER=brainseg-local
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=5000
WEB_PORT=4200
ML_PORT=8000
BACKEND_DEV_URL=http://127.0.0.1:5000
ASPNETCORE_ENVIRONMENT=Development
App__CorsOrigins=http://localhost:4200,http://127.0.0.1:4200
ObjectStorage__Provider=Local
ObjectStorage__RootPath=data/objects
ObjectStorage__Endpoint=http://localhost:9000
ObjectStorage__Bucket=brainseg
MlInference__BaseUrl=http://127.0.0.1:8000
ML_MODEL_PATH=
ML_MODEL_SHA256=
ML_MODEL_VERSION=unpublished
ML_PREPROCESSING_VERSION=flair-v1
ML_THRESHOLD=0.5
ML_MAX_UPLOAD_BYTES=67108864
ML_MAX_DECOMPRESSED_BYTES=134217728
ML_MAX_VOLUME_VOXELS=16777216
ML_REQUEST_TIMEOUT_SECONDS=30